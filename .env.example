# Diese Datei ist nur ein Beispiel. Echte Werte gehören in User Secrets oder Umgebungsvariablen, nicht in Git.
# dotnet user-secrets set "Jwt:SigningKey" "<48 zufällige Bytes>" --project src/GymPlatform.Api

# Datenbank: SqlServer (Standard) oder Sqlite (schnelle Demo)
Database__Provider=SqlServer
ConnectionStrings__Default=Server=(localdb)\MSSQLLocalDB;Database=GymPlatform;Trusted_Connection=True;TrustServerCertificate=True

# Authentifizierung (Pflicht in Production; in der Entwicklung wird sonst ein temporärer Schlüssel erzeugt)
Jwt__SigningKey=
Otp__Pepper=
# Nur Demo: SMS-Code auch in der API-Antwort zurückgeben (in Production immer false)
Otp__ExposeCodeInResponse=false

# SMS: Log (Demo, Code im Log) oder Kavenegar
Sms__Provider=Log
Sms__Kavenegar__ApiKey=
Sms__Kavenegar__Template=gym-otp

# Zahlung: Zahlungsanbieter mit Händlerkonto des Studios. Test-Gateway nur für Entwicklung/Demo (in Production verboten)
Payment__UseVirtualGateway=false
Payment__CallbackBaseUrl=
Payment__ZarinPal__MerchantId=

# Private Dateien (Vertrags-PDF) außerhalb von wwwroot
Storage__PrivateRoot=

# 21st.dev-Schlüssel (nur zum Installieren von Komponenten in der Entwicklung; niemals im Code oder Prompt)
API_KEY_21ST=

# ---- nur für docker compose ----
DB_PASSWORD=
JWT_SIGNING_KEY=
OTP_PEPPER=
# Production (Standard) oder Staging für eine interne Demo. In Production verhindern Demo-Einstellungen den Start.
APP_ENV=Production
# Domains der Seite, mit ; getrennt (Pflicht in Production)
SITE_HOSTS=
# Vollständige Adresse der Seite für die Rückkehr von der Bank, z. B. https://example.de
SITE_URL=
# Kurzadresse in SMS, z. B. example.de/join
SMS_SITE_URL=
ZARINPAL_MERCHANT_ID=
SMS_PROVIDER=Kavenegar
KAVENEGAR_API_KEY=
# Nur mit APP_ENV=Staging: Login-Code auf der Seite und Test-Gateway
OTP_EXPOSE_CODE=false
PAYMENT_SANDBOX=false
BEHIND_PROXY=true
