# این فایل فقط نمونه است. مقادیر واقعی را در User Secrets یا متغیر محیطی بگذارید، نه در گیت.
# dotnet user-secrets set "Jwt:SigningKey" "<۴۸ بایت تصادفی>" --project src/KhashayarGym.Api

# دیتابیس: SqlServer (پیش‌فرض) یا Sqlite (دموی سریع)
Database__Provider=SqlServer
ConnectionStrings__Default=Server=(localdb)\MSSQLLocalDB;Database=KhashayarGym;Trusted_Connection=True;TrustServerCertificate=True

# احراز هویت (الزامی در production؛ در توسعه اگر نباشد کلید موقت ساخته می‌شود)
Jwt__SigningKey=
Otp__Pepper=
# فقط دمو: کد پیامکی در پاسخ API هم برگردد (در production همیشه false)
Otp__ExposeCodeInResponse=false

# پیامک: Log (دمو، کد در لاگ) یا Kavenegar
Sms__Provider=Log
Sms__Kavenegar__ApiKey=
Sms__Kavenegar__Template=khashayar-otp

# درگاه: زرین‌پال با مرچنت به نام باشگاه. درگاه آزمایشی فقط برای توسعه/دمو (در Production ممنوع)
Payment__UseVirtualGateway=false
Payment__CallbackBaseUrl=
Payment__ZarinPal__MerchantId=

# فایل‌های خصوصی (PDF قرارداد) بیرون از wwwroot
Storage__PrivateRoot=

# کلید 21st.dev (فقط برای نصب کامپوننت در زمان توسعه؛ هرگز در کد یا پرامپت)
API_KEY_21ST=

# ---- فقط برای docker compose ----
DB_PASSWORD=
JWT_SIGNING_KEY=
OTP_PEPPER=
# Production (پیش‌فرض) یا Staging برای دموی داخلی. در Production تنظیمات دمو باعث می‌شود برنامه اجرا نشود.
APP_ENV=Production
# دامنه‌های سایت، با ; جدا (الزامی در Production)
SITE_HOSTS=
# آدرس کامل سایت برای بازگشت از بانک، مثل https://example.ir
SITE_URL=
# آدرس کوتاه داخل پیامک‌ها، مثل example.ir/join
SMS_SITE_URL=
ZARINPAL_MERCHANT_ID=
SMS_PROVIDER=Kavenegar
KAVENEGAR_API_KEY=
# فقط با APP_ENV=Staging: کد ورود روی صفحه و درگاه آزمایشی
OTP_EXPOSE_CODE=false
PAYMENT_SANDBOX=false
BEHIND_PROXY=true
